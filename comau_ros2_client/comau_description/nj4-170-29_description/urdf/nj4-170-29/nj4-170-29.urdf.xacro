    <link name="link_3_1_virtual">
    </link>

    <link name="link_3_1">
      <inertial>
        <origin xyz="-0.0644338140998114 -0.063152193647086 0.51885238255067" rpy="0 0 0" />
        <mass value="119.762661162239" />
        <inertia ixx="2.7506807175944" ixy="-0.135344693690216" ixz="-0.510528062059962" iyy="3.34744798113798" iyz="-0.579259059219219" izz="1.62613056221182" />
      </inertial>
