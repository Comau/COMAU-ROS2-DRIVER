          <mesh filename="package://nj4-170-29_description/meshes/nj4-170-aura/link3_1.STL" />
        </geometry>
      </collision>
    </link-->


    <!-- joints: parallel bar joints -->
    <!--joint name="joint_2_1" type="continuous">
      <origin xyz="0.4 -0.0975 0.52845" rpy="0 0 0" />
