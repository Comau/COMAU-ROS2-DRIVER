<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="racer3-robolab">

  <!--load racer3-robolab -->
  <xacro:include filename="$(find racer3-robolab_description)/urdf/racer3-robolab/racer3-robolab.urdf.xacro" />

  <xacro:racer3-robolab_description/>

  <!-- Import robot ros2_control description -->
  <xacro:include filename="$(find racer3-robolab_description)/ros2_control/racer3-robolab.ros2_control.xacro" />
  <xacro:robot_ros2_control name="racer3-robolab"/>

</robot>
