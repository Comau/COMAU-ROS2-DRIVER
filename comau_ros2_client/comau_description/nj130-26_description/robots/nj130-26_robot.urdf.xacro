<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="nj130-26">

   
  <xacro:include filename="$(find nj130-26_description)/urdf/nj130-26/nj130-26.urdf.xacro" />

  <xacro:nj130-26_desc/>

  <!-- Import robot ros2_control description -->
  <xacro:include filename="$(find nj130-26_description)/ros2_control/nj130-26.ros2_control.xacro" />
  <xacro:robot_ros2_control name="nj130-26"/>

  <link name="world" />

  <joint name="world_joint" type="fixed">
    <parent link="world" />
    <child link = "base_link" />
    <origin xyz="0 0 0" rpy="0 0 0" />
  </joint>



</robot>
