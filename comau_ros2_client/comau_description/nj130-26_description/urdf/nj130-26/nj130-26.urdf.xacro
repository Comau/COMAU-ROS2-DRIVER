            <collision>
            <origin xyz="0 0 0" rpy="0 0 0" />
            <geometry>
                <mesh filename="package://nj130-26_description/meshes/link2.STL" />
            </geometry>
            </collision>
        </link>

        <joint name="${prefix}joint_2" type="continuous">
            <origin xyz="0.35 0 0.53135" rpy="0 0 0" />
            <parent link="${prefix}link_1" />
            <child link="${prefix}link_2" />
            <axis xyz="0 1 0" />
        </joint>

        <link name="${prefix}link_3">
            <inertial>
            <origin xyz="-0.00823086364130676 0.0336245409135121 0.214015592296739" rpy="0 0 0" />
