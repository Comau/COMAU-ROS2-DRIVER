        <link name="${prefix}link_2">
            <inertial>
            <origin xyz="0.0239282633860053 -0.0242000728108603 0.523998538656614" rpy="0 0 0" />
            <mass value="179.411938551206" />
            <inertia
                ixx="24.9443415856971"
                ixy="0.0547214435284436"
                ixz="-0.0565192589255693"
