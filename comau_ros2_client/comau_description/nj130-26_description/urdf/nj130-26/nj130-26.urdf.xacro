        </joint>

        <link name="${prefix}link_5">
            <inertial>
            <origin xyz="0.0501381933007941 0.000255411382632705 0.000312892923768793" rpy="0 0 0" />
            <mass value="31.4945074401953" />
            <inertia
                ixx="0.0899904162298318"
                ixy="-0.00272588283998132"
                ixz="0.00261845532875675"
                iyy="0.236429812146763"
