            <origin xyz="0.35 -0.0975 0.53135" rpy="0 0 0" />
            <parent link="${prefix}link_1" />
            <child link="${prefix}link_2_ext" />
            <axis xyz="0 1 0" />
        </joint> 

        <link name="${prefix}link_3_ext">
            <inertial>
            <origin xyz="-0.0651470484626871 -0.0552527420542973 0.508837920565456" rpy="0 0 0" />
            <mass value="59.4972435307222" />
            <inertia
                ixx="5.23888307927869"
                ixy="-0.00036894066066532"
