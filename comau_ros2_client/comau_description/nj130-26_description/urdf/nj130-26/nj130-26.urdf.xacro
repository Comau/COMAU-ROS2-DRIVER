    <xacro:include filename="$(find nj130-26_description)/urdf/comau_common.macro.xacro" />
    <xacro:include filename="$(find nj130-26_description)/urdf/nj130-26/nj130-26.transmission.xacro" />
    <xacro:include filename="$(find nj130-26_description)/urdf/nj130-26/nj130-26.gazebo.xacro" />

    <xacro:macro name="nj130-26_robot" params="prefix transmission_hw_interface:=hardware_interface/PositionJointInterface">

        <xacro:nj130-26_transmission prefix="${prefix}" hw_interface="${transmission_hw_interface}" />
        <xacro:nj130-26_gazebo prefix="${prefix}" />
        <link name="${prefix}base_link">
            <inertial>
                <origin xyz="-0.0361845572105411 -3.05740596352742E-05 0.132251332860171" rpy="0 0 0" />
                <mass value="774.894943020899" />
                <inertia
                    ixx="25.6575789201931"
                    ixy="-0.00496689814433623"
                    ixz="0.0198401850217023"
                    iyy="33.5126130551"
                    iyz="-0.000259272865919447"
                    izz="47.9029473115196" />
            </inertial>
            <visual>
                <origin xyz="0 0 0" rpy="0 0 0" />
                <geometry>
                    <mesh filename="package://nj130-26_description/meshes/link0.STL" />
                </geometry>
                <material name="">
                    <color rgba="1 0 0 1" />
                </material>
            </visual>
            <collision>
                <origin xyz="0 0 0" rpy="0 0 0" />
                <geometry>
                    <mesh filename="package://nj130-26_description/meshes/link0.STL" />
                </geometry>
            </collision>
        </link>

        <link name="${prefix}link_1">
            <inertial>
            <origin xyz="0.223823373633036 0.0182515023064352 0.370408964002915" rpy="0 0 0" />
            <mass value="622.742568357298" />
            <inertia
                ixx="67.8176971990728"
                ixy="2.62565563323783"
                ixz="-14.9372082983885"
                iyy="51.0345456787575"
                iyz="0.850388863470645"
                izz="71.0963408141935" />
            </inertial>
            <visual>
                <origin xyz="0 0 0" rpy="0 0 0" />
                <geometry>
                <mesh filename="package://nj130-26_description/meshes/link1.STL" />
                </geometry>
                <material name="">
                <color rgba="1 0 0 1" />
                </material>
            </visual>
            <collision>
                <origin xyz="0 0 0" rpy="0 0 0" />
                <geometry>
                <mesh filename="package://nj130-26_description/meshes/link1.STL" />
                </geometry>
            </collision>
        </link>

        <joint name="${prefix}joint_1" type="continuous">
            <origin xyz="0 0 0.29865" rpy="0 0 0" />
            <parent link="${prefix}base_link" />
            <child link="${prefix}link_1" />
            <axis xyz="0 0 -1" />
        </joint>

