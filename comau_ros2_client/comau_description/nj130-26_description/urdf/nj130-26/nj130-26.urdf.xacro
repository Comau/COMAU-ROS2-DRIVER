        <link name="${prefix}ee_link"/>
        
        <joint name="${prefix}fixed_ee_joint" type="fixed">
            <origin
            xyz="0.0 0 0.0"
            rpy="0 ${M_PI/2} 0" />
            <parent link="${prefix}link_6"/>
            <child link="${prefix}ee_link"/>
