<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="racer5-cobot">

  <!--load racer5-cobot -->
  <xacro:include filename="$(find racer5-cobot_description)/urdf/racer5-cobot/racer5-cobot.urdf.xacro" />

  <xacro:racer5_cobot_description/>

  <!-- Import robot ros2_control description -->
  <xacro:include filename="$(find racer5-cobot_description)/ros2_control/racer5-cobot.ros2_control.xacro" />
  <xacro:robot_ros2_control name="racer5-cobot"/>

</robot>
