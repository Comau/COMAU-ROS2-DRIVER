<?xml version="1.0"?>
<robot xmlns:xacro="http://wiki.ros.org/xacro">

  <!-- 
    Author: LMS
   -->

  <xacro:include filename="$(find racer5-cobot_description)/urdf/comau_common.macro.xacro" />
  <xacro:include filename="$(find racer5-cobot_description)/urdf/racer5-cobot/racer5-cobot.transmission.xacro" />
  <xacro:include filename="$(find racer5-cobot_description)/urdf/racer5-cobot/racer5-cobot.gazebo.xacro" />

  <xacro:macro name="racer5-cobot_robot" params="prefix transmission_hw_interface:=hardware_interface/PositionJointInterface">

    <xacro:racer5-cobot_transmission prefix="${prefix}" hw_interface="${transmission_hw_interface}" />
    <xacro:racer5-cobot_gazebo prefix="${prefix}" />

    <link name="${prefix}base_link">
      <inertial>
        <origin xyz="-0.017279 0.00078009 0.14492" rpy="0 0 0" />
        <mass value="6.215" />
        <inertia ixx="0.05293" ixy="1.9878E-05" ixz="-0.0043586" iyy="0.060873" iyz="5.4713E-06" izz="0.042672" />
      </inertial>
      <visual>
        <origin xyz="0 0 0" rpy="0 0 0" />
        <geometry>
          <mesh filename="package://racer5-cobot_description/meshes/racer5-cobot/base_link.STL" />
        </geometry>
        <xacro:c_d_grey/>
      </visual>
      <collision>
        <xacro:col_mask_0/>
        <geometry>
          <mesh filename="package://racer5-cobot_description/meshes/racer5-cobot/base_link.STL" />
        </geometry>
      </collision>
    </link>

    <link name="${prefix}link_1">
      <inertial>
        <origin xyz="0.0375246972830294 -0.0047330722058841 0.119959023209445" rpy="0 0 0" />
        <mass value="5.46814182699305" />
        <inertia ixx="0.0559481276260512" ixy="9.66643445883554E-05" ixz="-0.00417556460736672" iyy="0.0332098630782273" iyz="1.37699311238088E-05" izz="0.0442971694125322" />
      </inertial>
      <visual>
        <origin xyz="0 0 -0.050" rpy="0 0 0" />
        <geometry>
          <mesh filename="package://racer5-cobot_description/meshes/racer5-cobot/Link1.STL" />
        </geometry>
        <xacro:c_white/>
      </visual>
      <collision>
        <xacro:col_mask_1/>
        <geometry>
          <mesh filename="package://racer5-cobot_description/meshes/racer5-cobot/Link1.STL" />
        </geometry>
      </collision>
    </link>
    
    <joint name="${prefix}joint_1" type="revolute">
      <origin xyz="0 0 0.242" rpy="0 0 0" />
      <parent link="base_link" />
      <child link="link_1" />
      <axis xyz="0 0 -1" />
      <limit lower="-2.966" upper="2.966" effort="100000.00" velocity="20.00" />
    </joint>
    
    <link name="link_2">
      <inertial>
        <origin xyz="-0.0190824069529527 -0.00775028525116991 0.199983435151925" rpy="0 0 0" />
        <mass value="3.4970386262029" />
        <inertia ixx="0.0677992942708836" ixy="0.000380936310688144" ixz="-0.000855778184674243" iyy="0.0676014641813283" iyz="0.00166834227020097" izz="0.0164275616508649" />
      </inertial>
      <visual>
        <origin xyz="0 0 0" rpy="0 0 0" />
        <geometry>
          <mesh filename="package://racer5-cobot_description/meshes/racer5-cobot/Link2.STL" />
        </geometry>
        <xacro:c_blue/>
      </visual>
      <collision>
        <xacro:col_mask_1/>
        <geometry>
          <mesh filename="package://racer5-cobot_description/meshes/racer5-cobot/Link2.STL" />
        </geometry>
      </collision>
    </link>
    
    <joint name="${prefix}joint_2" type="revolute">
      <origin xyz="0.05 0 0.123" rpy="0 0 0" />
      <parent link="link_1" />
      <child link="link_2" />
      <axis xyz="0 1 0" />
      <limit lower="-1.116" upper="1.99" effort="100000.00" velocity="20.00" />
    </joint>

    <link name="${prefix}link_3">
      <inertial>
        <origin xyz="-0.0174695057689258 -0.00108883931260707 -0.00846478214002855" rpy="0 0 0" />
        <mass value="2.68331708366552" />
        <inertia ixx="0.00685071381057224" ixy="0.000112640516973671" ixz="0.00186954281902629" iyy="0.00785316794831617" iyz="-0.000111709680917981" izz="0.00558392288230563" />
      </inertial>
      <visual>
        <origin xyz="0 0 0" rpy="0 0 3.14" />
        <geometry>
          <mesh filename="package://racer5-cobot_description/meshes/racer5-cobot/Link3.STL" />
        </geometry>
         <xacro:c_white/>
      </visual>
      <collision>
        <xacro:col_mask_0/>
        <geometry>
          <mesh filename="package://racer5-cobot_description/meshes/racer5-cobot/Link3.STL" />
        </geometry>
      </collision>
    </link>
    
    <joint name="${prefix}joint_3" type="revolute">
      <origin xyz="0 0 0.37" rpy="0 0 3.14" />
      <parent link="link_2" />
      <child link="link_3" />
      <axis xyz="0 1 0" />
      <limit lower="-2.62" upper="1.483" effort="100000.00" velocity="20.00" />
    </joint>
    
    <link name="${prefix}link_4">
      <inertial>
        <origin xyz="-0.00227788070042482 -0.00123420975347735 0.0624227170360064" rpy="0 0 0" />
        <mass value="1.62984418880799" />
        <inertia ixx="0.00636789477652846" ixy="-2.81769690428589E-06" ixz="-7.62862065969977E-05" iyy="0.00700400581464894" iyz="-3.84855032438523E-05" izz="0.00283764341486332" />
      </inertial>
      <visual>
        <origin xyz="0 0 0" rpy="0 0 3.14" />
        <geometry>
          <mesh filename="package://racer5-cobot_description/meshes/racer5-cobot/Link4.STL" />
        </geometry>
        <xacro:c_blue/>
      </visual>
      <collision>
        <xacro:col_mask_0/>
        <geometry>
          <mesh filename="package://racer5-cobot_description/meshes/racer5-cobot/Link4.STL" />
        </geometry>
      </collision>
    </link>
   
    <joint name="${prefix}joint_4" type="revolute">
      <origin xyz="0.05 0 0.0" rpy="0 0 0" />
      <parent link="link_3" />
      <child link="link_4" />
      <axis xyz="0 0 -1" />
      <limit lower="-3.49" upper="3.49" effort="100000.00" velocity="20.00" />
    </joint>
    
    <link name="${prefix}link_5">
      <inertial>
        <origin xyz="8.42234791683474E-06 0.000438242230281476 0.0364200996149726" rpy="0 0 0" />
        <mass value="0.805335362671064" />
        <inertia ixx="0.000450875634718755" ixy="-1.62647753017942E-07" ixz="5.47682000717453E-08" iyy="0.000482126973530289" iyz="2.28779867178509E-06" izz="0.000531776234546048" />
      </inertial>
      <visual>
        <origin xyz="0 0 0" rpy="0 0 0" />
        <geometry>
          <mesh filename="package://racer5-cobot_description/meshes/racer5-cobot/Link5.STL" />
        </geometry>
        <xacro:c_white/>
      </visual>
      <collision>
        <xacro:col_mask_1/>
        <geometry>
          <mesh filename="package://racer5-cobot_description/meshes/racer5-cobot/Link5.STL" />
        </geometry>
      </collision>
    </link>
    
    <joint name="${prefix}joint_5" type="revolute">
      <origin xyz="0 0 0.38594" rpy="0 0 0" />
      <parent link="link_4" />
      <child link="link_5" />
      <axis xyz="0 -1 0" />
      <limit lower="-1.83" upper="1.83" effort="100000.00" velocity="20.00" />
    </joint>
    
    <link name="${prefix}link_6">
      <inertial>
        <origin xyz="5.64165774402925E-05 -4.33361315668251E-07 0.00365583421206228" rpy="0 0 0" />
        <mass value="0.0730000000000003" />
        <inertia ixx="6.94455842253111E-06" ixy="-3.96352989850563E-10" ixz="-3.15927343591289E-08" iyy="6.89301150818147E-06" iyz="3.03515042445876E-10" izz="9.67078778400452E-06" />
      </inertial>
      <visual>
        <xacro:c_d_grey/>
        <geometry>
          <mesh filename="package://racer5-cobot_description/meshes/racer5-cobot/Link6.STL" />
        </geometry>
        <material name="">
          <color rgba="0.752941176470588 0.752941176470588 0.752941176470588 1" />
        </material>
      </visual>
      <collision>
        <xacro:col_mask_0/>
        <geometry>
          <mesh filename="package://racer5-cobot_description/meshes/racer5-cobot/Link6.STL" />
        </geometry>
      </collision>
    </link>

    <joint name="${prefix}joint_6" type="revolute">
      <origin xyz="0 0 0.08" rpy="0 0 0" />
      <parent link="link_5" />
      <child link="link_6" />
      <axis xyz="0 0 -1" />
      <limit lower="-100" upper="100" effort="100000.00" velocity="20.00" />
    </joint>

    <link name="${prefix}ee_link">
      <visual>
        <geometry>
          <cylinder length="0.001" radius="0.001"/>
        </geometry>
      </visual>
    </link>

    <joint name="${prefix}joint_ee_link" type="fixed">
      <origin xyz="0.0 0.0 0.0" rpy="0 0 3.14"/>
      <parent link="link_6"/>
      <child link="ee_link"/>
      <axis xyz="0 0 0"/>
    </joint>

  </xacro:macro>

</robot>
