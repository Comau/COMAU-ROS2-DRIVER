<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="edo">
  <!-- Import Rviz colors -->
  <xacro:include filename="$(find edo_description)/urdf/materials.xacro" />
  <!--load edo -->
  <xacro:include filename="$(find edo_description)/urdf/edo/edo.urdf.xacro" />

  <xacro:edo_description/>

  <!-- Import robot ros2_control description -->
  <xacro:include filename="$(find edo_description)/ros2_control/edo.ros2_control.xacro" />
  <xacro:robot_ros2_control name="edo"/>

</robot>
